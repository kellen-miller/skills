{
  "path": [
    "src",
    "tests"
  ],
  "format": [
    "rust"
  ],
  "reporters": [
    "threshold"
  ],
  "minLines": 8,
  "minTokens": 80,
  "threshold": 5,
  "ignore": [
    "**/node_modules/**",
    "**/.svelte-kit/**",
    "**/build/**",
    "**/coverage/**",
    "**/.data/**",
    "**/target/**",
    "**/.agent/**",
    "**/.worktrees/**",
    "**/_managed/**"
  ],
  "gitignore": true,
  "mode": "mild"
}
